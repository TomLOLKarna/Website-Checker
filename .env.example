# === Pflicht-Konfiguration ===

# Discord-Webhook-URL für Alerts
# Erstellen: Discord-Server → Kanal-Einstellungen → Integrationen → Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/DEINE_WEBHOOK_ID/DEIN_WEBHOOK_TOKEN

# Die URL deiner Production-Site (ohne abschließenden Slash)
SITE_URL=https://ostermann-digital.de

# === Phase 2 (Self-Healing) – aktuell noch nicht nötig ===

# Anthropic API-Key (holen auf: console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...

# Vercel Personal Access Token (holen auf: vercel.com/account/tokens)
# VERCEL_TOKEN=...

# GitHub Personal Access Token mit repo-Scope (für gh pr create)
# GITHUB_TOKEN wird in GitHub Actions automatisch bereitgestellt

# Phase 2 aktivieren (erst setzen wenn ANTHROPIC_API_KEY gesetzt ist!)
# AGENTS_ENABLED=true
